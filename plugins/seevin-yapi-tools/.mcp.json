{
  "mcpServers": {
    "yapi-get-interface-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "yapi-get-interface-mcp",
        "--email",
        "YOUR_EMAIL_HERE",
        "--password",
        "YOUR_PASSWORD_HERE",
        "--url",
        "YOUR_YAPI_URL_HERE"
      ]
    }
  }
}